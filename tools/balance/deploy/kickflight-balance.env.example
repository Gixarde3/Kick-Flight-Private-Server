# Kick-Flight balance WebUI environment. Install as /etc/kickflight-balance.env, mode 0600, and keep
# it out of the repository. Format: KEY=VALUE, one per line. Authentication is mandatory; no
# account is created automatically.

# Base masters shipped by the CI deploy (read-only; the API mounts it into its container).
KF_BALANCE_BASE_DIR=/opt/kickflight/config

# Tuned per-table overrides. .local/ is excluded from the CI rsync, so these survive every deploy.
KF_BALANCE_OVERRIDE_DIR=/opt/kickflight/.local/masters-overrides

# One backup per overwritten override (or base) file.
KF_BALANCE_BACKUP_DIR=/opt/kickflight/.local/balance-backups

# Auth DB stores password hashes and hashes of JWT session IDs, never plaintext credentials.
KF_BALANCE_AUTH_DB=/opt/kickflight/.local/balance-auth/auth.sqlite3
# Required 256-bit random HS256 signing key; owned by ubuntu and mode 0600. Missing/insecure files fail closed.
KF_BALANCE_JWT_SECRET_FILE=/opt/kickflight/.local/balance-auth/jwt-secret

# Public site is served through Caddy at https://kick-flight-fenix.us.ci/balance/.
KF_BALANCE_BASE_PATH=/balance
KF_BALANCE_ALLOWED_HOSTS=kick-flight-fenix.us.ci
KF_BALANCE_ALLOWED_ORIGINS=https://kick-flight-fenix.us.ci
# Caddy is the only trusted reverse proxy and supplies X-Real-IP for login throttling.
KF_BALANCE_TRUSTED_PROXIES=127.0.0.1,::1
