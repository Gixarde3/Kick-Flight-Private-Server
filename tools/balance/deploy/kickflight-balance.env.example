# Kick-Flight balance WebUI environment. Install as /etc/kickflight-balance.env, mode 0600, and keep
# it out of the repository. The systemd unit already sets these paths; this file is the place to
# override them or to add the optional HTTP basic auth password. Format: KEY=VALUE, one per line.

# Base masters shipped by the CI deploy (read-only; the API mounts it into its container).
KF_BALANCE_BASE_DIR=/opt/kickflight/config

# Tuned per-table overrides. .local/ is excluded from the CI rsync, so these survive every deploy.
KF_BALANCE_OVERRIDE_DIR=/opt/kickflight/.local/masters-overrides

# One backup per overwritten override (or base) file.
KF_BALANCE_BACKUP_DIR=/opt/kickflight/.local/balance-backups

# Optional: require HTTP basic auth. Leave the password unset/empty to disable auth (the unit only
# listens on 127.0.0.1, reached over an SSH tunnel).
# KF_BALANCE_USER=balance
# KF_BALANCE_PASSWORD=

# Optional: extra Host values the tool accepts, on top of 127.0.0.1:<port>, localhost:<port> and
# [::1]:<port>. Not needed for the loopback + SSH-tunnel deployment; set it only when the tool is
# bound to a LAN address or behind a proxy that forwards a different Host.
# KF_BALANCE_ALLOWED_HOSTS=balance.example:8765
