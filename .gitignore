# Build outputs
bin/
obj/
TestResults/
coverage/
*.trx

# Python bytecode caches: regenerated by whichever interpreter runs a script, so they only ever
# show up as noise in git status (and the tracked ones were dirtied by any edit to their source)
__pycache__/
*.pyc

# Local development certificates and private keys
certs/*
!certs/.gitignore

# Captured traffic may contain local identifiers
captures/*
!captures/.gitignore

# Local runtime state
.local/
logs/
*.db
*.db-shm
*.db-wal
# Maintenance switch (MaintenanceState), written under the API content root
**/data/maintenance.json*

# Android packages and protected game assets
*.apk
*.apks
*.aab
*.obb
*.unity3d
*.bundle

# Small generated bundles required by the reconstructed title catalog. Keep these
# exact runtime dependencies in source control; the wider game-asset bundles stay ignored.
!content/resources/ui-kicker-skin-thumbnails/*.bundle
!content/resources/actioneditor/41616564303032_dee54a556d81fcda9d315a76db8890b7.bundle
!content/resources/actioneditor/41616564303033_3f32616ee89bb55126b858bff3e7c7b0.bundle
!content/resources/actioneditor/41616564303036_cb77a351fe13164d9b51b953bac6e47e.bundle
!content/resources/actioneditor/41616564303037_b6c33d5cb0d2617553424471dfcb05f4.bundle
!content/resources/actioneditor/41616564303039_c6f4912e584fc7e1ed1dd4f998024e5f.bundle
!content/resources/actioneditor/41616564303130_3ac020c25db80644f90ac82ce82fe280.bundle
!content/resources/actioneditor/41616564303132_56fdf1f05b6c9ab45c10915c318fb668.bundle
!content/resources/actioneditor/41616564303133_a71afc179b4bee7bc53418b114e34a1a.bundle
!content/resources/actioneditor/41616564303134_9b23d2ac8b9238b44e45f09cc493aed3.bundle
!content/resources/ui-disc/41746862303435_9f460b2f03aae42c43addcb5becf8e88.bundle
!content/resources/ui-disc/41746862303936_ccbd49e4ff62e96253ea7e58a42b8854.bundle
!content/resources/ui-disc/41746862313333_1aab02d38b9dbc1f785a70e9e4b7008c.bundle
!content/resources/ui-disc/41746862313336_601c906099595dee711fc4a3caed75bd.bundle
!content/resources/ui-disc/41746862313338_f11dc3aa7e02b25e6c655b9931f13510.bundle

# IDE and OS files
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Local overrides
appsettings.Local.json
config/fixtures.local/
config/apk-direct-server.local.json
deploy/.env
.codebase-memory/
octo_cache.tar
# DeepSeek handoff rounds
handoff/

# Local environment secrets
/.env
