# Build outputs
bin/
obj/
TestResults/
coverage/
*.trx

# Python bytecode caches: regenerated by whichever interpreter runs a script, so they only ever
# show up as noise in git status (and the tracked ones were dirtied by any edit to their source)
__pycache__/
*.pyc

# Local development certificates and private keys
certs/*
!certs/.gitignore

# Captured traffic may contain local identifiers
captures/*
!captures/.gitignore

# Local runtime state
.local/
logs/
*.db
*.db-shm
*.db-wal

# Android packages and protected game assets
*.apk
*.apks
*.aab
*.obb
*.unity3d
*.bundle

# Small generated bundles required by the reconstructed title catalog. Keep these
# exact runtime dependencies in source control; the wider game-asset bundles stay ignored.
!content/resources/actioneditor/41616564303032_72b678ed95d9c27697625b32fa4f85bc.bundle
!content/resources/actioneditor/41616564303033_fc92f19957606a76839bfebf767fd0da.bundle
