From 42796b65a43aa571d65fb9e2f2e494c2e4406599 Mon Sep 17 00:00:00 2001
From: tanuki <t@x>
Date: Mon, 21 Sep 2026 10:40:34 +0000
Subject: [PATCH] enet: 4096-entry reliable receive window (ENet default);
 Kick-Flight rooms overflowed the 128 window and dropped reliable packets

---
 include/luxon/enet_peer.hpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/luxon/enet_peer.hpp b/include/luxon/enet_peer.hpp
index 2096f32..ad77ca4 100644
--- a/include/luxon/enet_peer.hpp
+++ b/include/luxon/enet_peer.hpp
@@ -180,10 +180,10 @@ public:
     std::queue<EnetCommand> outgoing_unreliable;
 
     // incoming storage
-    sliding_flat_map<uint32_t, EnetCommand, 128> incoming_reliable;           // by reliable_seq
-    sliding_flat_map<uint32_t, EnetCommand, 256> incoming_unreliable;         // by unreliable_seq
+    sliding_flat_map<uint32_t, EnetCommand, 4096> incoming_reliable;           // by reliable_seq
+    sliding_flat_map<uint32_t, EnetCommand, 1024> incoming_unreliable;         // by unreliable_seq
     std::queue<EnetCommand> incoming_unsequenced;                             // ready to dispatch (also reassembled frags)
-    sliding_flat_map<uint32_t, EnetCommand, 64> incoming_unsequenced_frags;   // reliable_seq -> fragment cmd for unsequenced fragments
+    sliding_flat_map<uint32_t, EnetCommand, 256> incoming_unsequenced_frags;   // reliable_seq -> fragment cmd for unsequenced fragments
 
     // seq numbers
     uint32_t incoming_reliable_seq = 0;
-- 
2.43.0

